# ============ 必填：大模型（OpenAI 兼容协议） ============
# OpenAI / DeepSeek / 通义千问 / vLLM / Xinference 等均可，只需要改 base_url 与模型名
OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 国产模型示例（DeepSeek）：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ============ 数据库（docker compose 默认值，一般不用改） ============
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kb

# ============ 可选参数 ============
DEFAULT_COLLECTION=default
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=8
RERANK_TOP_K=4
ENABLE_RERANK=true
# 接口鉴权（留空表示不鉴权）
API_KEY=
