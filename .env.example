# ============================================================
# 所有配置都从本文件读取（复制成 .env 后生效：cp .env.example .env）
# 修改后重启服务：docker compose restart app
# ============================================================

# ---------------- 必填：大模型（OpenAI 兼容协议）----------------
# OpenAI / DeepSeek / 通义 / 硅流动 / vLLM / Xinference 都行，改 base_url 与模型名即可
OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---------------- 服务 ----------------
APP_NAME=企业知识库问答系统
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
API_KEY=
MAX_UPLOAD_MB=100

# ---------------- 数据库（Docker 内默认连 db，本地开发用 localhost）----------------
# Docker 里由 compose 覆盖为 db:5432；本地直连请写 localhost:5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kb

# ---------------- 模型细节 ----------------
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
EMBEDDING_DIM=1536        # 未配置 KEY 时用「假向量」的维度

# ---------------- 索引（切分）----------------
DEFAULT_COLLECTION=default
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# JSON 数组写法；中文文档请保留句号等标点，避免整段被硬切断
CHUNK_SEPARATORS=["\n\n","\n","。","！","？","；","，"," ",""]
PDF_EXTRACT_TABLES=true

# ---------------- 检索 ----------------
TOP_K=8                   # 单路召回条数
RERANK_TOP_K=4            # 重排后送进模型的条数
ENABLE_RERANK=true
ENABLE_BM25=true          # 关闭则只用向量检索
VECTOR_WEIGHT=0.5         # 混合检索中向量检索权重
BM25_WEIGHT=0.5           # 混合检索中 BM25 权重
BM25_CACHE_TTL=300        # BM25 索引缓存秒数

# ---------------- 提示词（可选：用文件覆盖默认提示词）----------------
# SYSTEM_PROMPT_FILE=/app/prompts/system.txt
# REWRITE_PROMPT_FILE=/app/prompts/rewrite.txt

# ---------------- 评测 ----------------
EVAL_SIZE=20
EVAL_USE_RAGAS=true

# ---------------- 目录（一般不用改）----------------
# UPLOAD_DIR=/app/data/uploads
# EVAL_DIR=/app/data/eval
